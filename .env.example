# GEMINI_API_KEY: Required for Gemini AI API calls (optional if using only local GGUF models).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VLLM_API_KEY: Optional static API Bearer token for /v1/* and /api/* endpoints.
# If unset, vLLM Gateway guides you through a one-time token setup stored hashed (scrypt) in config.json.
# VLLM_API_KEY="sk-vllm-change-me-strong-token"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# HOST: Bind address (defaults to 127.0.0.1; use 0.0.0.0 only behind an authenticated, trusted network boundary)
HOST="127.0.0.1"

# PORT: HTTP server port (defaults to 3003)
PORT="3003"

# LOG_LEVEL: debug | info | warn | error (defaults to info)
# LOG_LEVEL="info"

# VLLM_DATA_DIR: Directory for config, logs, downloaded GGUF models and llama-server binaries (defaults to ~/.vllm-gateway)
# VLLM_DATA_DIR="/path/to/.vllm-gateway"

# LLAMA_SERVER_PATH: Optional explicit path to llama-server executable
# LLAMA_SERVER_PATH="/usr/local/bin/llama-server"

# HF_TOKEN / MODELSCOPE_TOKEN: Optional tokens for private or gated repositories
# HF_TOKEN=""
# MODELSCOPE_TOKEN=""
